<Application x:Class="Kirimdong.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Tailwind CSS neutral scale for everything; orange-500 is the one accent, and only marks what is moving
         (the shipment track, the portal, a drop target). Actions are black, or white on dark. -->
    <SolidColorBrush x:Key="Ground" Color="#FAFAFA" />       <!-- neutral-50 -->
    <SolidColorBrush x:Key="Tile" Color="#F5F5F5" />         <!-- neutral-100 -->
    <SolidColorBrush x:Key="TileHover" Color="#E5E5E5" />    <!-- neutral-200 -->
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ink" Color="#0A0A0A" />          <!-- neutral-950 -->
    <SolidColorBrush x:Key="Ink2" Color="#737373" />         <!-- neutral-500: 4.6:1 on neutral-100 -->
    <SolidColorBrush x:Key="Ink3" Color="#D4D4D4" />         <!-- neutral-300: dividers only, never text -->
    <SolidColorBrush x:Key="OnInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#F97316" />       <!-- orange-500: shapes only, never behind text -->
    <SolidColorBrush x:Key="Dark" Color="#171717" />         <!-- neutral-900 -->
    <SolidColorBrush x:Key="DarkTile" Color="#262626" />     <!-- neutral-800 -->
    <SolidColorBrush x:Key="DarkInk2" Color="#A3A3A3" />     <!-- neutral-400: 7.4:1 on neutral-900 -->
    <SolidColorBrush x:Key="Scrim" Color="#66000000" />

    <!-- Inter (SIL OFL 1.1), bundled. -->
    <FontFamily x:Key="Display">pack://application:,,,/Assets/fonts/#Inter</FontFamily>
    <FontFamily x:Key="Text">pack://application:,,,/Assets/fonts/#Inter</FontFamily>
    <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Data (sizes, speeds, addresses, time left) in tabular figures, so numbers do not shift as they change. -->
    <Style x:Key="Data" TargetType="TextBlock">
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <BitmapImage x:Key="ImgPackage" UriSource="pack://application:,,,/Assets/3d/package.png" />
    <BitmapImage x:Key="ImgLaptop" UriSource="pack://application:,,,/Assets/3d/laptop.png" />
    <BitmapImage x:Key="ImgDesktop" UriSource="pack://application:,,,/Assets/3d/desktop_computer.png" />
    <BitmapImage x:Key="ImgTruck" UriSource="pack://application:,,,/Assets/3d/delivery_truck.png" />
    <BitmapImage x:Key="ImgFolder" UriSource="pack://application:,,,/Assets/3d/file_folder.png" />
    <BitmapImage x:Key="ImgAntenna" UriSource="pack://application:,,,/Assets/3d/satellite_antenna.png" />
    <BitmapImage x:Key="ImgShield" UriSource="pack://application:,,,/Assets/3d/shield.png" />
    <BitmapImage x:Key="ImgInbox" UriSource="pack://application:,,,/Assets/3d/inbox_tray.png" />
    <BitmapImage x:Key="ImgEdges" UriSource="pack://application:,,,/Assets/3d/left-right_arrow.png" />
    <BitmapImage x:Key="ImgSearch" UriSource="pack://application:,,,/Assets/3d/magnifying_glass_tilted_left.png" />
    <BitmapImage x:Key="ImgEnvelope" UriSource="pack://application:,,,/Assets/3d/incoming_envelope.png" />
    <BitmapImage x:Key="ImgLink" UriSource="pack://application:,,,/Assets/3d/link.png" />

    <!-- Tailwind shadow-lg and shadow-2xl. -->
    <DropShadowEffect x:Key="Lift" BlurRadius="15" ShadowDepth="10" Direction="270" Opacity="0.10" Color="#000000" />
    <DropShadowEffect x:Key="LiftStrong" BlurRadius="50" ShadowDepth="25" Direction="270" Opacity="0.25" Color="#000000" />

    <Style x:Key="Focus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-4" RadiusX="12" RadiusY="12" Stroke="#3B82F6" StrokeThickness="2" /> <!-- Tailwind ring: blue-500 -->
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pill buttons: black for the main action, orange to accept, grey or white for the rest. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Ink}" />
      <Setter Property="Foreground" Value="{StaticResource OnInk}" />
      <Setter Property="FontFamily" Value="{StaticResource Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource Tile}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="WhiteButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="DarkGhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#343434" />
      <Setter Property="Foreground" Value="{StaticResource OnInk}" />
    </Style>

    <!-- Quiet words that act, like "See All". -->
    <Style x:Key="WordButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
      <Setter Property="FontFamily" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Background="Transparent" Foreground="{TemplateBinding Foreground}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Foreground" Value="{StaticResource Ink}" />
                <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A grey tile that is itself the button (service tile). -->
    <Style x:Key="TileButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Tile}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource TileHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value></Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="{StaticResource Glyphs}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Tile}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Borderless text field, placed inside a pill. -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontFamily" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch: grey track, black when on. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontFamily" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Border x:Name="track" DockPanel.Dock="Right" Width="40" Height="24" CornerRadius="12" Background="#D4D4D4" VerticalAlignment="Center" Margin="10,0,0,0">
                <Ellipse Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="slide" /></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Ink}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15" /></Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" /></Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The same switch on the dark sheet: white track, dark knob when on. -->
    <Style x:Key="DarkSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
      <Setter Property="Foreground" Value="{StaticResource OnInk}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Border x:Name="track" DockPanel.Dock="Right" Width="40" Height="24" CornerRadius="12" Background="#404040" VerticalAlignment="Center" Margin="10,0,0,0">
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="slide" /></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource OnInk}" />
                <Setter TargetName="knob" Property="Fill" Value="{StaticResource Dark}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15" /></Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" /></Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Status pill, like "Transit" / "Delivered". -->
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Tile}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#2E000000" CornerRadius="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="Visible" />
  </Application.Resources>
</Application>
