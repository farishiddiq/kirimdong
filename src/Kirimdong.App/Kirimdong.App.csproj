<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>kirimdong</AssemblyName>
    <RootNamespace>Kirimdong.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>kirimdong</Product>
    <Version>1.1.0</Version>
    <Company>farishiddiq</Company>
    <Copyright>Copyright (c) 2026 farishiddiq</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kirimdong.Core\Kirimdong.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
