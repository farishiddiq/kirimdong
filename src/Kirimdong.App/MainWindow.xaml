<Window x:Class="Kirimdong.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Kirimdong.App.Controls"
        Title="kirimdong" Width="1180" Height="740" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{StaticResource Ground}" FontFamily="{StaticResource Text}"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True" TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <c:EdgeBrush x:Key="EdgeFill" />
    <c:EdgeBrush x:Key="EdgeGlyph" Glyph="True" />

    <!-- One of four arrows on a PC tile: which edge of this screen leads to that PC. -->
    <Style x:Key="EdgeButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="FontFamily" Value="{StaticResource Glyphs}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>

    <!-- A PC on the same Wi-Fi: a grey service tile with a 3D laptop. Drop files on it to send. -->
    <DataTemplate x:Key="PeerLabel">
      <Grid Width="284" Height="250" Margin="0,0,14,14" AllowDrop="True" Background="Transparent"
            DragEnter="Peer_DragEnter" DragOver="Peer_DragOver" DragLeave="Peer_DragLeave" Drop="Peer_Drop">
        <Border x:Name="tile" Background="{StaticResource Tile}" CornerRadius="20" Padding="18,16,18,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="{StaticResource ImgLaptop}" Width="86" Height="86" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-8,-6,0" Grid.RowSpan="3" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,88,0" ToolTip="{Binding Name}" />
            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Margin="0,4,0,0">
              <Run Text="Kepada ·" /> <Run Text="{Binding Address, Mode=OneWay}" />
            </TextBlock>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Content="Kirim file" Click="PickFiles_Click" />
              <Button Style="{StaticResource WhiteButton}" Content="Folder" Margin="8,0,0,0" Click="PickFolder_Click" />
            </StackPanel>
            <DockPanel Grid.Row="4" Margin="0,14,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource EdgeButton}" Tag="left" Content="&#xE76B;" Click="Edge_Click" ToolTip="PC ini ada di kiri layarmu"
                        Background="{Binding Edge, Converter={StaticResource EdgeFill}, ConverterParameter=left}"
                        Foreground="{Binding Edge, Converter={StaticResource EdgeGlyph}, ConverterParameter=left}" />
                <Button Style="{StaticResource EdgeButton}" Tag="top" Content="&#xE70E;" Click="Edge_Click" ToolTip="PC ini ada di atas layarmu"
                        Background="{Binding Edge, Converter={StaticResource EdgeFill}, ConverterParameter=top}"
                        Foreground="{Binding Edge, Converter={StaticResource EdgeGlyph}, ConverterParameter=top}" />
                <Button Style="{StaticResource EdgeButton}" Tag="bottom" Content="&#xE70D;" Click="Edge_Click" ToolTip="PC ini ada di bawah layarmu"
                        Background="{Binding Edge, Converter={StaticResource EdgeFill}, ConverterParameter=bottom}"
                        Foreground="{Binding Edge, Converter={StaticResource EdgeGlyph}, ConverterParameter=bottom}" />
                <Button Style="{StaticResource EdgeButton}" Tag="right" Content="&#xE76C;" Click="Edge_Click" ToolTip="PC ini ada di kanan layarmu"
                        Background="{Binding Edge, Converter={StaticResource EdgeFill}, ConverterParameter=right}"
                        Foreground="{Binding Edge, Converter={StaticResource EdgeGlyph}, ConverterParameter=right}" />
              </StackPanel>
              <TextBlock Text="Tepi layar" Style="{StaticResource Label}" VerticalAlignment="Center" />
            </DockPanel>
            <CheckBox Grid.Row="5" Style="{StaticResource Switch}" Margin="0,10,0,0" IsChecked="{Binding IsTrusted, Mode=TwoWay}"
                      ToolTip="Paket dari PC ini langsung disimpan tanpa kartu Terima/Tolak">
              <TextBlock Text="Langsung terima dari PC ini" FontSize="12.5" Foreground="{StaticResource Ink2}" />
            </CheckBox>
          </Grid>
        </Border>
        <!-- Something is being dragged over it: the black tile with the orange arrow. -->
        <Border Background="{StaticResource Ink}" CornerRadius="20" Padding="22" IsHitTestVisible="False"
                Visibility="{Binding IsDropTarget, Converter={StaticResource Visible}}">
          <Grid>
            <StackPanel>
              <TextBlock Text="Lepas untuk kirim" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource OnInk}" />
              <TextBlock Text="{Binding Name}" FontSize="15" Foreground="{StaticResource DarkInk2}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource Glyphs}" FontSize="52" Foreground="{StaticResource Accent}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="tile" Property="Background" Value="{StaticResource TileHover}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A transfer, like a shipment card: what, where to, the dotted track and its status. -->
    <DataTemplate x:Key="Slip">
      <Border Background="#F6F6F6" CornerRadius="18" Padding="16,14,16,14" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource Card}" Margin="8,2,0,0">
              <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold" />
            </Border>
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Card}" VerticalAlignment="Top">
              <Image x:Name="icon" Source="{StaticResource ImgEnvelope}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Margin="12,1,0,0">
              <TextBlock Text="{Binding Summary}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
              <TextBlock Text="{Binding Route}" Style="{StaticResource Label}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
          <c:DotTrack Grid.Row="1" Margin="0,14,0,8" Value="{Binding Progress, Mode=OneWay}" IsDone="{Binding IsDone, Mode=OneWay}"
                      IsProblem="{Binding IsProblem, Mode=OneWay}" />
          <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource WordButton}" Content="Hapus" Margin="0,0,14,0" VerticalAlignment="Center" Click="Dismiss_Click"
                    Visibility="{Binding CanDismiss, Converter={StaticResource Visible}}" ToolTip="Hapus dari daftar (file tidak ikut terhapus)" />
            <Button Style="{StaticResource WhiteButton}" Content="Batal" Padding="14,6" Click="Cancel_Click"
                    Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource AccentButton}" Content="Buka" Padding="16,6" Click="Open_Click"
                    Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSend}" Value="True">
          <Setter TargetName="icon" Property="Source" Value="{StaticResource ImgPackage}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Frame">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Margin="24,0,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Kecilkan" />
        <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Besarkan" />
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Tutup" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="{StaticResource ImgPackage}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="kirimdong" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold" Margin="10,0,0,1" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="24,0,24,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="370" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,10,0">
        <StackPanel>
          <!-- Windows Firewall keeps other PCs out: the black tile, the usual reason two laptops cannot see each other. -->
          <Border x:Name="FirewallBanner" Background="{StaticResource Dark}" CornerRadius="20" Padding="18,16,18,16" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="{StaticResource ImgShield}" Width="52" Height="52" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="PC lain belum bisa menghubungi PC ini" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OnInk}" />
                <TextBlock x:Name="BannerText" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource DarkInk2}" />
              </StackPanel>
              <Button x:Name="BannerButton" Grid.Column="2" Style="{StaticResource AccentButton}" Content="Izinkan" Click="FixFirewall_Click" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TextBlock Text="Kirim ke mana?" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="Bold" Margin="0,2,0,14" />

          <!-- This PC, as the "From … / Where to?" bar. The name is edited in place. -->
          <Border Background="{StaticResource Tile}" CornerRadius="18" Padding="12,10,18,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="{StaticResource ImgDesktop}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}">
                  <Run Text="Dari PC ini ·" /> <Run x:Name="MyAddress" />
                </TextBlock>
                <TextBox x:Name="NameBox" Style="{StaticResource Field}" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold"
                         MaxLength="40" Margin="0,1,0,0" ToolTip="Klik untuk ganti nama yang dilihat PC lain"
                         KeyDown="NameBox_KeyDown" LostKeyboardFocus="NameBox_LostFocus" />
              </StackPanel>
              <Rectangle Grid.Column="2" Width="1" Height="26" Fill="{StaticResource Ink3}" Margin="14,0" />
              <Button Grid.Column="3" Style="{StaticResource WordButton}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Content="Cek koneksi"
                      VerticalAlignment="Center" Click="CheckConnection_Click" />
            </Grid>
          </Border>

          <DockPanel Margin="0,26,0,2">
            <TextBlock x:Name="PeerCount" DockPanel.Dock="Right" FontSize="13" Foreground="{StaticResource Ink2}" VerticalAlignment="Bottom" />
            <TextBlock Text="PC di Wi-Fi yang sama" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" />
          </DockPanel>
          <TextBlock x:Name="HowTo" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,14"
                     Text="Seret file ke kartu PC tujuan, atau ke tepi layar yang dipilih di kartunya." />

          <Grid>
            <ItemsControl x:Name="PeerList" ItemTemplate="{StaticResource PeerLabel}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Nobody yet. -->
            <Border x:Name="EmptyState" Background="{StaticResource Tile}" CornerRadius="20" Padding="24,20" Margin="0,0,14,14">
              <Grid>
                <StackPanel Margin="0,0,170,0" VerticalAlignment="Center">
                  <TextBlock Text="Belum ada PC lain" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20">
                    Buka kirimdong di PC lain yang tersambung ke Wi-Fi yang sama. Kartunya muncul di sini dalam beberapa detik.
                  </TextBlock>
                  <TextBlock FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20">
                    Masih kosong? Tekan Cek koneksi, di kedua PC.
                  </TextBlock>
                </StackPanel>
                <Image Source="{StaticResource ImgPackage}" Width="140" Height="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>
            </Border>
          </Grid>

          <TextBlock Text="Pengaturan" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Tile}" CornerRadius="18" Padding="14,12,14,12">
              <StackPanel>
                <Image Source="{StaticResource ImgFolder}" Width="44" Height="44" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Folder simpan" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="SaveFolderText" Style="{StaticResource Label}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Style="{StaticResource WordButton}" Foreground="{StaticResource Ink}" Content="Buka" Click="OpenSaveFolder_Click" />
                  <Button Style="{StaticResource WordButton}" Foreground="{StaticResource Ink}" Content="Ganti" Margin="14,0,0,0" Click="ChangeFolder_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Tile}" CornerRadius="18" Padding="14,12,14,12">
              <StackPanel>
                <DockPanel>
                  <CheckBox x:Name="AutoAcceptBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top"
                            Checked="AutoAccept_Changed" Unchecked="AutoAccept_Changed" ToolTip="Terima otomatis dari semua PC" />
                  <Image Source="{StaticResource ImgInbox}" Width="44" Height="44" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                </DockPanel>
                <TextBlock Text="Terima otomatis" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="dari semua PC, tanpa tanya" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource Tile}" CornerRadius="18" Padding="14,12,14,12">
              <StackPanel>
                <DockPanel>
                  <CheckBox x:Name="PortalBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top"
                            Checked="Portal_Changed" Unchecked="Portal_Changed" ToolTip="Seret file ke tepi layar yang kamu pilih di kartu PC tujuan" />
                  <Image Source="{StaticResource ImgEdges}" Width="44" Height="44" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                </DockPanel>
                <TextBlock Text="Kirim lewat tepi layar" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="seret file ke tepi layar" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <Button Grid.Column="6" Style="{StaticResource TileButton}" Padding="14,12,14,12" Click="CheckConnection_Click">
              <StackPanel>
                <Image Source="{StaticResource ImgAntenna}" Width="44" Height="44" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Cek koneksi" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="firewall, Wi-Fi, pindai" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Add a PC by address, for networks that block broadcasts: a search-style pill. -->
          <TextBlock Text="PC tidak muncul? Tambah lewat IP" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Tile}" CornerRadius="24" Height="48" Padding="18,0">
              <DockPanel>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{StaticResource Ink2}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="IpBox" Style="{StaticResource Field}" KeyDown="IpBox_KeyDown" ToolTip="Contoh: 192.168.1.20" />
              </DockPanel>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Tambah" Height="48" Padding="24,0" Margin="10,0,0,0" Click="AddByIp_Click" />
          </Grid>
          <TextBlock x:Name="IpStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="18,8,0,6"
                     Text="Lihat IP di kartu PC tujuan, contoh 192.168.1.20" />
        </StackPanel>
      </ScrollViewer>

      <!-- Shipments: what is moving and what arrived. -->
      <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="24" Padding="20,18,16,6" Effect="{StaticResource Lift}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,4,14">
            <Image DockPanel.Dock="Right" Source="{StaticResource ImgTruck}" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Pengiriman" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Yang dikirim dan diterima" Style="{StaticResource Label}" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <Border x:Name="NoSlips" Grid.Row="1" Background="#F6F6F6" CornerRadius="18" Padding="18,16" VerticalAlignment="Top" Margin="0,0,4,0">
            <StackPanel>
              <c:DotTrack Value="0" Margin="0,0,0,12" />
              <TextBlock FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" LineHeight="20"
                         Text="Belum ada paket. Semua yang kamu kirim dan terima tercatat di sini, lengkap dengan kecepatan dan sisa waktunya." />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
            <ItemsControl x:Name="SlipList" ItemTemplate="{StaticResource Slip}" Focusable="False" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- An incoming parcel: the dark shipment sheet. -->
    <Grid x:Name="OfferLayer" Grid.RowSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed">
      <Border Width="540" Background="{StaticResource Dark}" CornerRadius="26" Padding="26,22,26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Effect="{StaticResource LiftStrong}">
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource DarkTile}">
              <TextBlock x:Name="OfferCountdown" FontSize="11.5" Foreground="{StaticResource OnInk}" />
            </Border>
            <TextBlock Text="Paket masuk" FontSize="13" Foreground="{StaticResource DarkInk2}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="OfferSummary" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource OnInk}"
                     TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
          <c:DotTrack OnDark="True" Value="0" Margin="0,16,0,16" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Isi" FontSize="12" Foreground="{StaticResource DarkInk2}" />
              <TextBlock x:Name="OfferSize" FontSize="14.5" Foreground="{StaticResource OnInk}" Margin="0,2,0,12" TextWrapping="Wrap" />
              <TextBlock Text="Disimpan ke" FontSize="12" Foreground="{StaticResource DarkInk2}" />
              <TextBlock x:Name="OfferFolder" FontSize="13" Foreground="{StaticResource OnInk}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
              <ItemsControl x:Name="OfferFiles">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource DarkInk2}" TextTrimming="CharacterEllipsis" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="OfferMore" FontSize="12" Foreground="{StaticResource DarkInk2}" />
            </StackPanel>
            <Image Grid.Column="1" Source="{StaticResource ImgPackage}" Width="128" Height="128" VerticalAlignment="Top" Margin="12,-6,-8,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
          <CheckBox x:Name="OfferTrust" Style="{StaticResource DarkSwitch}" Margin="0,16,0,0">
            <TextBlock x:Name="OfferTrustText" Text="Lain kali langsung terima dari PC ini" FontSize="13" />
          </CheckBox>
          <!-- Who sent it, and the two answers. -->
          <Border Background="{StaticResource DarkTile}" CornerRadius="24" Padding="10,10,10,10" Margin="0,18,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="44" Height="44" CornerRadius="22" Background="#333333">
                <Image Source="{StaticResource ImgLaptop}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="OfferSender" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OnInk}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Pengirim" FontSize="12" Foreground="{StaticResource DarkInk2}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource DarkGhostButton}" Content="Tolak" Padding="20,10" Click="Decline_Click" />
                <Button x:Name="AcceptButton" Style="{StaticResource AccentButton}" Content="Terima" Padding="24,10" Margin="8,0,0,0" Click="Accept_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Connection check: what keeps two PCs apart, and the one-click fix. -->
    <Grid x:Name="CheckLayer" Grid.RowSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed">
      <Border Width="640" Background="{StaticResource Card}" CornerRadius="26" Padding="28,24,28,26" HorizontalAlignment="Center" VerticalAlignment="Center"
              Effect="{StaticResource LiftStrong}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Tutup" Click="CloseCheck_Click" VerticalAlignment="Top" />
            <TextBlock Text="Cek koneksi" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold" />
          </DockPanel>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="{StaticResource ImgLink}" Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="Jaringan" FontSize="14.5" FontWeight="SemiBold" />
              <TextBlock x:Name="CheckNetwork" FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <Image Grid.Row="1" Source="{StaticResource ImgAntenna}" Width="40" Height="40" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,18,0,0">
              <TextBlock Text="Kecepatan" FontSize="14.5" FontWeight="SemiBold" />
              <TextBlock x:Name="CheckSpeed" FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <Image Grid.Row="2" Source="{StaticResource ImgShield}" Width="40" Height="40" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,18,0,0">
              <TextBlock Text="Firewall" FontSize="14.5" FontWeight="SemiBold" />
              <TextBlock x:Name="CheckFirewall" FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0" />
              <Button x:Name="CheckFixButton" Style="{StaticResource PrimaryButton}" Content="Izinkan kirimdong" HorizontalAlignment="Left"
                      Margin="0,10,0,0" Click="FixFirewall_Click" />
            </StackPanel>

            <Image Grid.Row="3" Source="{StaticResource ImgSearch}" Width="40" Height="40" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,18,0,0">
              <TextBlock Text="Pencarian" FontSize="14.5" FontWeight="SemiBold" />
              <TextBlock x:Name="CheckDiscovery" FontSize="13.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0" />
              <Button x:Name="SweepButton" Style="{StaticResource GhostButton}" Content="Pindai jaringan sekarang" HorizontalAlignment="Left"
                      Margin="0,10,0,0" Click="Sweep_Click" />
            </StackPanel>
          </Grid>
          <Border Background="{StaticResource Tile}" CornerRadius="16" Padding="16,12" Margin="0,22,0,0">
            <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Ink2}">
              Lakukan cek ini di kedua PC. Kalau firewall keduanya sudah diizinkan tapi tetap tidak saling ketemu, router kemungkinan
              memisahkan perangkat (client isolation, biasa di Wi-Fi tamu, kantor, atau kampus). Jalan pintasnya: nyalakan Mobile hotspot
              di salah satu laptop (Settings → Network &amp; internet → Mobile hotspot) lalu sambungkan laptop lain ke hotspot itu.
            </TextBlock>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
