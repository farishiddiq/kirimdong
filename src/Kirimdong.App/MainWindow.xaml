<Window x:Class="Kirimdong.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Kirimdong.App.Controls"
        Title="kirimdong" Width="1140" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource KraftBrush}" FontFamily="{StaticResource Display}"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- A PC on the same Wi-Fi, as the address label of a parcel. Drop files on it to send. -->
    <DataTemplate x:Key="PeerLabel">
      <Grid Width="300" Height="200" Margin="0,0,22,22" AllowDrop="True" Background="Transparent"
            DragEnter="Peer_DragEnter" DragOver="Peer_DragOver" DragLeave="Peer_DragLeave" Drop="Peer_Drop"
            RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><RotateTransform x:Name="tilt" Angle="0" /></Grid.RenderTransform>
        <Grid.Triggers>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
              <Storyboard><DoubleAnimation Storyboard.TargetName="tilt" Storyboard.TargetProperty="Angle" To="-1.2" Duration="0:0:0.18" /></Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
              <Storyboard><DoubleAnimation Storyboard.TargetName="tilt" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.22" /></Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
        <c:PaperCard Fill="{DynamicResource PaperBrush}" Notch="12">
          <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Address}" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" />
              <TextBlock Text="Kepada" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Name}" FontFamily="{StaticResource Hand}" FontSize="32" FontWeight="Bold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <Button Style="{StaticResource InkButton}" Content="Pilih file" Click="PickFiles_Click" />
              <Button Style="{StaticResource KraftButton}" Content="Folder" Margin="8,0,0,0" Click="PickFolder_Click" />
            </StackPanel>
          </Grid>
        </c:PaperCard>
        <c:PaperCard Fill="{StaticResource Accent}" Notch="12" IsHitTestVisible="False"
                     Visibility="{Binding IsDropTarget, Converter={StaticResource Visible}}">
          <StackPanel VerticalAlignment="Center" Margin="22,0">
            <TextBlock Text="Lepas untuk kirim" FontSize="30" FontWeight="Bold" FontStretch="Condensed" />
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Hand}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </c:PaperCard>
      </Grid>
    </DataTemplate>

    <!-- A transfer as a tear-off delivery slip. -->
    <DataTemplate x:Key="Slip">
      <c:PaperCard Fill="{DynamicResource PaperBrush}" Notch="8" Punched="True" HoleBrush="{StaticResource KraftFlat}" Margin="0,0,10,10" MinHeight="84">
        <Grid Margin="34,12,18,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Direction}" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" />
            <TextBlock Text="{Binding PeerName}" FontFamily="{StaticResource Hand}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,18,0">
            <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
            <ProgressBar x:Name="meter" Style="{StaticResource Meter}" Value="{Binding Progress, Mode=OneWay}" Margin="0,7,0,6" />
            <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource KraftButton}" Content="Batal" Click="Cancel_Click"
                    Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource InkButton}" Content="Buka" Click="Open_Click"
                    Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource WordButton}" Content="Hapus" Margin="14,0,0,0" VerticalAlignment="Center" Click="Dismiss_Click"
                    Visibility="{Binding CanDismiss, Converter={StaticResource Visible}}" ToolTip="Hapus dari daftar (file tidak ikut terhapus)" />
          </StackPanel>
        </Grid>
      </c:PaperCard>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="meter" Property="Foreground" Value="{StaticResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsProblem}" Value="True">
          <Setter TargetName="meter" Property="Foreground" Value="#8A8F94" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Frame">
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title: the name stamped on the box. -->
    <DockPanel Margin="32,0,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Kecilkan" />
        <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Besarkan" />
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Tutup" />
      </StackPanel>
      <TextBlock Text="kirimdong" FontSize="46" FontWeight="Bold" FontStretch="SemiCondensed" VerticalAlignment="Bottom" Margin="0,0,0,2" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="32,18,32,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- This PC: the sender's label, taped on. -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:PaperCard Fill="{DynamicResource PaperBrush}" Notch="14" Margin="0,14,0,0">
          <StackPanel>
            <c:Barcode x:Name="MyBarcode" Height="54" Margin="22,26,22,0" Ink="{StaticResource Ink}" />
            <StackPanel Margin="22,18,22,22">
              <TextBlock Text="Dari PC ini" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" />
              <TextBox x:Name="NameBox" FontFamily="{StaticResource Hand}" FontSize="34" FontWeight="Bold" Background="Transparent"
                       BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,2" Foreground="{StaticResource Ink}"
                       CaretBrush="{StaticResource Ink}" SelectionBrush="{StaticResource Accent}" MaxLength="40"
                       ToolTip="Klik untuk ganti nama yang dilihat PC lain" KeyDown="NameBox_KeyDown" LostKeyboardFocus="NameBox_LostFocus">
                <TextBox.Template>
                  <ControlTemplate TargetType="TextBox">
                    <Border x:Name="line" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent">
                      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="line" Property="BorderBrush" Value="{StaticResource KraftLight}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="line" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </TextBox.Template>
              </TextBox>
              <TextBlock x:Name="MyAddress" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" />

              <TextBlock Text="Paket masuk disimpan di" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" Margin="0,22,0,2" />
              <TextBlock x:Name="SaveFolderText" FontSize="15" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource WordButton}" Content="Ganti folder" Click="ChangeFolder_Click" />
                <Button Style="{StaticResource WordButton}" Content="Buka folder" Margin="18,0,0,0" Click="OpenSaveFolder_Click" />
              </StackPanel>

              <CheckBox x:Name="AutoAcceptBox" Style="{StaticResource Tick}" Margin="0,22,0,0" Checked="AutoAccept_Changed" Unchecked="AutoAccept_Changed">
                <TextBlock Text="Langsung terima tanpa tanya" TextWrapping="Wrap" />
              </CheckBox>
            </StackPanel>
          </StackPanel>
        </c:PaperCard>
        <c:Tape Width="150" Height="30" Fill="{StaticResource TapeBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="96,0,0,0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <c:Tape.RenderTransform><RotateTransform Angle="-3" /></c:Tape.RenderTransform>
        </c:Tape>

        <!-- Add a PC by address, for networks that block broadcasts. -->
        <c:PaperCard Grid.Row="2" Fill="{DynamicResource KraftDarkBrush}" Notch="10">
          <StackPanel Margin="20,16,20,18">
            <TextBlock Text="PC tidak muncul? Tambah lewat IP" FontSize="15" FontWeight="SemiBold" />
            <DockPanel Margin="0,10,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource InkButton}" Content="Tambah" Click="AddByIp_Click" IsDefault="False" />
              <TextBox x:Name="IpBox" Style="{StaticResource Field}" Margin="0,0,8,0" KeyDown="IpBox_KeyDown" ToolTip="Contoh: 192.168.1.20" />
            </DockPanel>
            <TextBlock x:Name="IpStatus" FontSize="13" Foreground="{StaticResource InkOnKraftMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Lihat IP di label PC tujuan, contoh 192.168.1.20" />
          </StackPanel>
        </c:PaperCard>
      </Grid>

      <!-- Other PCs and the slips of what is moving. -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,8,0,18">
          <TextBlock x:Name="PeerCount" DockPanel.Dock="Right" FontSize="15" VerticalAlignment="Bottom" Foreground="{StaticResource InkOnKraftMuted}" />
          <StackPanel>
            <TextBlock Text="Kirim ke PC di Wi-Fi yang sama" FontSize="30" FontWeight="SemiBold" FontStretch="SemiCondensed" />
            <TextBlock Text="Seret file atau folder ke label tujuan, atau tekan Pilih file." FontSize="15" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl x:Name="PeerList" ItemTemplate="{StaticResource PeerLabel}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>

        <!-- Nobody yet: the empty box, waiting. -->
        <Grid x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Canvas Width="220" Height="190">
            <!-- open box, front view: inside, flaps, front panel, tape -->
            <Polygon Points="30,70 190,70 190,96 30,96" Fill="#4A2F14" />
            <Polygon Points="30,70 4,30 92,30 110,70" Fill="#B7884E" />
            <Polygon Points="190,70 216,30 128,30 110,70" Fill="#A2733B" />
            <Polygon Points="22,88 198,88 198,184 22,184" Fill="#B98A50" />
            <Polygon Points="22,88 198,88 198,98 22,98" Fill="#A57640" />
            <Polygon Points="96,88 124,88 124,184 96,184" Fill="{StaticResource TapeBrush}" />
            <Polygon Points="140,128 186,128 186,170 140,170" Fill="{StaticResource Accent}" />
            <Polygon Points="148,138 151,138 151,162 148,162" Fill="{StaticResource Ink}" />
            <Polygon Points="155,138 160,138 160,162 155,162" Fill="{StaticResource Ink}" />
            <Polygon Points="164,138 166,138 166,162 164,162" Fill="{StaticResource Ink}" />
            <Polygon Points="170,138 177,138 177,162 170,162" Fill="{StaticResource Ink}" />
          </Canvas>
          <StackPanel Grid.Column="1" Margin="30,18,0,0" MaxWidth="420">
            <TextBlock Text="Belum ada PC lain" FontSize="30" FontWeight="SemiBold" FontStretch="SemiCondensed" />
            <TextBlock FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="23">
              Buka kirimdong di PC lain yang tersambung ke Wi-Fi yang sama. Labelnya muncul di sini dalam beberapa detik.
            </TextBlock>
            <TextBlock FontSize="15" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="23">
              Waktu pertama dibuka, Windows menanyakan izin firewall. Pilih Izinkan untuk jaringan Private, di kedua PC.
            </TextBlock>
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Pengiriman" FontSize="22" FontWeight="SemiBold" FontStretch="SemiCondensed" Margin="0,4,0,12" />
        <c:PaperCard x:Name="NoSlips" Grid.Row="3" Fill="{DynamicResource KraftDarkBrush}" Notch="10" VerticalAlignment="Top" Margin="0,0,10,0">
          <TextBlock Margin="22,18" FontSize="15" TextWrapping="Wrap"
                     Text="Belum ada paket. Semua yang kamu kirim dan terima tercatat di sini, lengkap dengan kecepatan dan sisa waktunya." />
        </c:PaperCard>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="290">
          <ItemsControl x:Name="SlipList" ItemTemplate="{StaticResource Slip}" Focusable="False" />
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- An incoming parcel: everything else waits under a scrim. -->
    <Grid x:Name="OfferLayer" Grid.RowSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed">
      <Grid Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <c:PaperCard Fill="{DynamicResource PaperBrush}" Notch="16">
          <StackPanel>
            <c:Barcode x:Name="OfferBarcode" Height="50" Margin="28,30,28,0" Ink="{StaticResource Ink}" />
            <StackPanel Margin="28,20,28,26">
              <TextBlock Text="Ada paket untukmu dari" FontSize="15" Foreground="{StaticResource InkOnPaperMuted}" />
              <TextBlock x:Name="OfferSender" FontFamily="{StaticResource Hand}" FontSize="40" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="OfferSummary" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="OfferSize" FontSize="15" Margin="0,2,0,0" />
              <ItemsControl x:Name="OfferFiles" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" TextTrimming="CharacterEllipsis" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="OfferMore" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" />
              <TextBlock x:Name="OfferFolder" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
              <DockPanel Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AcceptButton" Style="{StaticResource InkButton}" Content="Terima" FontSize="17" Padding="26,11" Click="Accept_Click" />
                  <Button Style="{StaticResource KraftButton}" Content="Tolak" FontSize="17" Padding="22,11" Margin="10,0,0,0" Click="Decline_Click" />
                </StackPanel>
                <TextBlock x:Name="OfferCountdown" FontSize="13" Foreground="{StaticResource InkOnPaperMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </c:PaperCard>
        <c:Tape Width="130" Height="30" Fill="{StaticResource TapeBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-12,60,0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <c:Tape.RenderTransform><RotateTransform Angle="4" /></c:Tape.RenderTransform>
        </c:Tape>
      </Grid>
    </Grid>
  </Grid>
</Window>
